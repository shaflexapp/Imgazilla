# Copy to .env (yarn build) or .env.development.local (yarn dev).
# Every value here is inlined into the plugin bundle, so it is public.
# NODE_ENV comes from webpack --mode; do not set it here.

# API base URL, e.g. https://imgazilla.app/api. Required for production builds.
BASE_API_URL=
# Must match REQUESTS_SECRET_KEY on the API (x-Figma-id / x-Figma-Signature).
REQUESTS_SECRET_KEY=

# Credit prices shown in the UI. Keep in sync with the API's values.
IMAGE_CREDITS_COST=
FAVICON_ARCHIVE_CREDITS_COST=
BACKGROUND_REMOVAL_COST=

SENTRY_DSN_LINK=
MIXPANEL_TOKEN=
